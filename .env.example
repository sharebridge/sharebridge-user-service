# Copy to .env for local runs (never commit secrets).
PORT=8081
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
AUTH_TOKEN_SECRET=sharingbridge-dev-secret-change-me
AUTH_TOKEN_ISSUER=sharingbridge-user-service
AUTH_TOKEN_AUDIENCE=sharingbridge-clients
AUTH_TOKEN_TTL_SECONDS=3600
WEB_CORS_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_ID_ANDROID=
# LOG_LEVEL=warn

# Tests / local without Postgres:
# USER_STORE=memory
