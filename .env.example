PORT=8081

# Local: copy to .env — loaded automatically on `npm start` (dotenv).
# Render: set the same keys in the dashboard (no .env file on the host).

# Must match sharingbridge-integration-service (HS256 JWT)
AUTH_TOKEN_SECRET=change-me-use-render-generated-secret
AUTH_TOKEN_ISSUER=sharingbridge-user-service
AUTH_TOKEN_AUDIENCE=sharingbridge-clients
AUTH_TOKEN_TTL_SECONDS=3600

# Browser web app sign-in (sharingbridge-web-app). Same origins as integration-service.
WEB_CORS_ORIGINS=http://localhost:5173

# Google Sign-In (OAuth client IDs from Google Cloud Console)
GOOGLE_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com
# Optional shorthand when one ID is shared in dev:
# GOOGLE_CLIENT_ID=...

# Coordinator allowlist (web dashboard). Copy data/coordinators.json.example → data/coordinators.json
# COORDINATOR_EMAILS=coord@example.com,other@example.com

# Local-only: restore POST /v1/auth/token { user_id } for tests and manual smoke
ALLOW_DEV_TOKEN_MINT=true
