# Copy to .env for local runs (never commit secrets).
PORT=8081
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
AUTH_TOKEN_SECRET=sharingbridge-dev-secret-change-me
AUTH_TOKEN_ISSUER=sharingbridge-user-service
AUTH_TOKEN_AUDIENCE=sharingbridge-clients
AUTH_TOKEN_TTL_SECONDS=3600
WEB_CORS_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_ID_ANDROID=
# LOG_LEVEL=warn

# Postgres client pool + retry (optional — defaults shown)
# DB_POOLING=true
# DB_POOL_MIN=0
# DB_POOL_MAX=5
# DB_CONNECTION_IDLE_LIFETIME_SECONDS=60
# DB_TIMEOUT_SECONDS=30
# DB_COMMAND_TIMEOUT_SECONDS=30
# DB_SUPABASE_POOL_6543TRANS_5432SESSION=5432SESSION
# Allowed: 5432SESSION (default, Npgsql-safe) | 6543TRANS | AS_IS
# DB_RETRY_MAX_ATTEMPTS=3
# DB_RETRY_BASE_DELAY_MS=200

# Tests / local without Postgres:
# USER_STORE=memory
